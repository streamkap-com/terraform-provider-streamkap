{
  "contract_version": 1,
  "producer": "app.services.smt.catalog_artifact",
  "digest": "sha256:14490b96403b4c36f0592777270fe8a6ee9abc75a59386f3d6de9c548cc7f2f9",
  "types": [
    {
      "label": "Regex router",
      "type_id": "regex_router",
      "schema_version": 1,
      "codec_version": 1,
      "publishable": true,
      "kind": "kafka_connect_smt",
      "role": "transform",
      "categories": [
        "route_record"
      ],
      "description": "Send each record to a topic derived from its own by a regular expression",
      "disabled_reason": null,
      "input_arity": "one",
      "output_arity": "one",
      "can_create_topics": false,
      "data_schema": {
        "additionalProperties": false,
        "properties": {
          "regex": {
            "title": "Regex",
            "type": "string"
          },
          "replacement": {
            "default": "$0",
            "title": "Replacement",
            "type": "string"
          }
        },
        "required": [
          "regex"
        ],
        "title": "RegexRouterConfig",
        "type": "object"
      },
      "ui_schema": {
        "type": "Category",
        "label": "Regex router",
        "elements": [
          {
            "type": "Control",
            "scope": "#/properties/regex",
            "options": {
              "control": "string"
            }
          },
          {
            "type": "Control",
            "scope": "#/properties/replacement",
            "options": {
              "control": "string"
            }
          }
        ]
      },
      "secret_paths": [],
      "row_keys": {},
      "examples": {
        "read_projection": {
          "regex": "(.*)",
          "replacement": "$1"
        }
      },
      "alias_base": "RegexRouter",
      "hosts": [
        "destinations"
      ],
      "kc_class": "org.apache.kafka.connect.transforms.RegexRouter",
      "package": "kafka-connect"
    },
    {
      "label": "Mask field",
      "type_id": "mask_field",
      "schema_version": 1,
      "codec_version": 1,
      "publishable": true,
      "kind": "kafka_connect_smt",
      "role": "transform",
      "categories": [
        "modify_column"
      ],
      "description": "Replace the values of chosen columns with a hash, a fixed value or null",
      "disabled_reason": null,
      "input_arity": "one",
      "output_arity": "one",
      "can_create_topics": false,
      "data_schema": {
        "additionalProperties": false,
        "properties": {
          "fields_include": {
            "items": {
              "pattern": "^[^,]+$",
              "type": "string"
            },
            "title": "Fields Include",
            "type": "array"
          },
          "fields_exclude": {
            "items": {
              "pattern": "^[^,]+$",
              "type": "string"
            },
            "title": "Fields Exclude",
            "type": "array"
          },
          "mask_function": {
            "default": "SHA256_TRUNCATE",
            "enum": [
              "SHA256_TRUNCATE",
              "MD5_TRUNCATE",
              "SHA256",
              "MD5",
              "REDACT",
              "FIXED",
              "NULLIFY"
            ],
            "title": "Mask Function",
            "type": "string"
          },
          "mask_salt": {
            "default": "",
            "format": "password",
            "title": "Mask Salt",
            "type": "string",
            "writeOnly": true
          },
          "mask_char": {
            "default": "*",
            "title": "Mask Char",
            "type": "string"
          },
          "mask_fixed_value": {
            "default": "***",
            "title": "Mask Fixed Value",
            "type": "string"
          },
          "replace_null_with_default": {
            "default": true,
            "title": "Replace Null With Default",
            "type": "boolean"
          }
        },
        "required": [
          "fields_include"
        ],
        "title": "MaskFieldConfig",
        "type": "object"
      },
      "ui_schema": {
        "type": "Category",
        "label": "Mask field",
        "elements": [
          {
            "type": "Control",
            "scope": "#/properties/fields_include",
            "options": {
              "control": "multi-select"
            }
          },
          {
            "type": "Control",
            "scope": "#/properties/fields_exclude",
            "options": {
              "control": "multi-select"
            }
          },
          {
            "type": "Control",
            "scope": "#/properties/mask_function",
            "options": {
              "control": "one-select"
            }
          },
          {
            "type": "Control",
            "scope": "#/properties/mask_salt",
            "options": {
              "control": "password"
            }
          },
          {
            "type": "Control",
            "scope": "#/properties/mask_char",
            "options": {
              "control": "string"
            }
          },
          {
            "type": "Control",
            "scope": "#/properties/mask_fixed_value",
            "options": {
              "control": "string"
            }
          },
          {
            "type": "Control",
            "scope": "#/properties/replace_null_with_default",
            "options": {
              "control": "toggle"
            }
          }
        ]
      },
      "secret_paths": [
        "/mask_salt"
      ],
      "row_keys": {},
      "examples": {
        "read_projection": {
          "fields_include": [
            "email"
          ],
          "fields_exclude": [],
          "mask_function": "SHA256_TRUNCATE",
          "mask_char": "*",
          "mask_fixed_value": "***",
          "replace_null_with_default": true
        }
      },
      "alias_base": "MaskField",
      "hosts": [
        "destinations"
      ],
      "kc_class": "com.streamkap.kafka.connect.transforms.MaskField$Value",
      "package": "streamkap-transforms-multi-converter"
    },
    {
      "label": "Drop fields",
      "type_id": "drop_fields",
      "schema_version": 1,
      "codec_version": 1,
      "publishable": true,
      "kind": "kafka_connect_smt",
      "role": "transform",
      "categories": [
        "delete_column"
      ],
      "description": "Remove the chosen columns from every record before the sink writes it",
      "disabled_reason": null,
      "input_arity": "one",
      "output_arity": "one",
      "can_create_topics": false,
      "data_schema": {
        "additionalProperties": false,
        "description": "``DropFields`` extends ``FieldTransformBase`` and adds nothing: its config is the base's.",
        "properties": {
          "fields_include": {
            "items": {
              "pattern": "^[^,]+$",
              "type": "string"
            },
            "title": "Fields Include",
            "type": "array"
          },
          "fields_exclude": {
            "items": {
              "pattern": "^[^,]+$",
              "type": "string"
            },
            "title": "Fields Exclude",
            "type": "array"
          },
          "replace_null_with_default": {
            "default": true,
            "title": "Replace Null With Default",
            "type": "boolean"
          }
        },
        "required": [
          "fields_include"
        ],
        "title": "DropFieldsConfig",
        "type": "object"
      },
      "ui_schema": {
        "type": "Category",
        "label": "Drop fields",
        "elements": [
          {
            "type": "Control",
            "scope": "#/properties/fields_include",
            "options": {
              "control": "multi-select"
            }
          },
          {
            "type": "Control",
            "scope": "#/properties/fields_exclude",
            "options": {
              "control": "multi-select"
            }
          },
          {
            "type": "Control",
            "scope": "#/properties/replace_null_with_default",
            "options": {
              "control": "toggle"
            }
          }
        ]
      },
      "secret_paths": [],
      "row_keys": {},
      "examples": {
        "read_projection": {
          "fields_include": [
            "orders.debug_blob"
          ],
          "fields_exclude": [],
          "replace_null_with_default": true
        }
      },
      "alias_base": "DropFields",
      "hosts": [
        "destinations"
      ],
      "kc_class": "com.streamkap.kafka.connect.transforms.DropFields$Value",
      "package": "streamkap-transforms-multi-converter"
    }
  ]
}
