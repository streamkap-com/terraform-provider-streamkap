{
  "contract_version": 1,
  "producer": "app.services.smt.catalog_artifact",
  "digest": "sha256:d480e9429775b68f93bdb6a243873c4e5313834e25aa71d5941c2d060a4acbae",
  "types": [
    {
      "label": "Regex router",
      "type_id": "regex_router",
      "schema_version": 1,
      "codec_version": 1,
      "publishable": true,
      "data_schema": {
        "additionalProperties": false,
        "properties": {
          "regex": {
            "title": "Regex",
            "type": "string"
          },
          "replacement": {
            "default": "$0",
            "title": "Replacement",
            "type": "string"
          }
        },
        "required": [
          "regex"
        ],
        "title": "RegexRouterConfig",
        "type": "object"
      },
      "ui_schema": {
        "type": "Category",
        "label": "Regex router",
        "elements": [
          {
            "type": "Control",
            "scope": "#/properties/regex",
            "options": {
              "control": "string"
            }
          },
          {
            "type": "Control",
            "scope": "#/properties/replacement",
            "options": {
              "control": "string"
            }
          }
        ]
      },
      "secret_paths": [],
      "row_keys": {},
      "examples": {
        "read_projection": {
          "regex": "(.*)",
          "replacement": "$1"
        }
      },
      "alias_base": "RegexRouter",
      "hosts": [
        "destinations"
      ],
      "kc_class": "org.apache.kafka.connect.transforms.RegexRouter",
      "package": "kafka-connect"
    },
    {
      "label": "Mask field",
      "type_id": "mask_field",
      "schema_version": 1,
      "codec_version": 1,
      "publishable": true,
      "data_schema": {
        "additionalProperties": false,
        "properties": {
          "fields_include": {
            "items": {
              "pattern": "^[^,]+$",
              "type": "string"
            },
            "title": "Fields Include",
            "type": "array"
          },
          "fields_exclude": {
            "items": {
              "pattern": "^[^,]+$",
              "type": "string"
            },
            "title": "Fields Exclude",
            "type": "array"
          },
          "mask_function": {
            "default": "SHA256_TRUNCATE",
            "enum": [
              "SHA256_TRUNCATE",
              "MD5_TRUNCATE",
              "SHA256",
              "MD5",
              "REDACT",
              "FIXED",
              "NULLIFY"
            ],
            "title": "Mask Function",
            "type": "string"
          },
          "mask_salt": {
            "default": "",
            "format": "password",
            "title": "Mask Salt",
            "type": "string",
            "writeOnly": true
          },
          "mask_char": {
            "default": "*",
            "title": "Mask Char",
            "type": "string"
          },
          "mask_fixed_value": {
            "default": "***",
            "title": "Mask Fixed Value",
            "type": "string"
          },
          "replace_null_with_default": {
            "default": true,
            "title": "Replace Null With Default",
            "type": "boolean"
          }
        },
        "required": [
          "fields_include"
        ],
        "title": "MaskFieldConfig",
        "type": "object"
      },
      "ui_schema": {
        "type": "Category",
        "label": "Mask field",
        "elements": [
          {
            "type": "Control",
            "scope": "#/properties/fields_include",
            "options": {
              "control": "multi-select"
            }
          },
          {
            "type": "Control",
            "scope": "#/properties/fields_exclude",
            "options": {
              "control": "multi-select"
            }
          },
          {
            "type": "Control",
            "scope": "#/properties/mask_function",
            "options": {
              "control": "one-select"
            }
          },
          {
            "type": "Control",
            "scope": "#/properties/mask_salt",
            "options": {
              "control": "password"
            }
          },
          {
            "type": "Control",
            "scope": "#/properties/mask_char",
            "options": {
              "control": "string"
            }
          },
          {
            "type": "Control",
            "scope": "#/properties/mask_fixed_value",
            "options": {
              "control": "string"
            }
          },
          {
            "type": "Control",
            "scope": "#/properties/replace_null_with_default",
            "options": {
              "control": "toggle"
            }
          }
        ]
      },
      "secret_paths": [
        "/mask_salt"
      ],
      "row_keys": {},
      "examples": {
        "read_projection": {
          "fields_include": [
            "email"
          ],
          "fields_exclude": [],
          "mask_function": "SHA256_TRUNCATE",
          "mask_char": "*",
          "mask_fixed_value": "***",
          "replace_null_with_default": true
        }
      },
      "alias_base": "MaskField",
      "hosts": [
        "destinations"
      ],
      "kc_class": "com.streamkap.kafka.connect.transforms.MaskField$Value",
      "package": "streamkap-transforms-multi-converter"
    }
  ]
}
